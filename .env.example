# Local development uses MinIO from docker-compose by default.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=jobby-assets
STORAGE_PUBLIC_BASE_URL=http://localhost:9000
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin

# DeepSeek is used only by the API server. Keep the key out of browser variables.
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-v4-flash

# Supabase Storage through its S3-compatible API (recommended when using S3 keys).
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=jobby-assets
# STORAGE_S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
# STORAGE_S3_REGION=ap-southeast-2
# STORAGE_S3_ACCESS_KEY_ID=your-s3-access-key
# STORAGE_S3_SECRET_ACCESS_KEY=your-s3-secret-key
# STORAGE_PUBLIC_BASE_URL=https://your-project.supabase.co/storage/v1/object/public

# Optional Supabase REST adapter. Use a private service-role key only on the API server.
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
