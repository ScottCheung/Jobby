  "rules": [
    {
      "id": "colors",
      "title": "颜色规范",
      "rule": "只用 token（text-ink-primary、bg-panel、border-border），禁止 zinc-*、slate-*、gray-* 等硬编码颜色"
    },
    {
      "id": "spacing",
      "title": "间距规范",
      "rule": "使用语义 padding token：p-page、p-panel、p-card、p-sidebar"
    },
    {
      "id": "radius",
      "title": "圆角规范",
      "rule": "优先 .rounded-card、.rounded-button；需要具体时：rounded-xl（panel）、rounded-2xl（card 内）、rounded-full（pill/button）"
    },
    {
      "id": "typography",
      "title": "文字规范",
      "rule": "用排版类（.label、.label-overline、.section-title），禁止内联 font-size + weight + color 组合"
    },
    {
      "id": "layout",
      "title": "布局规范",
      "rule": "用 .row、.col、.stack 等工具类替代高频内联 flex 组合"
    },
    {
      "id": "exceptions",
      "title": "例外情况",
      "rule": "游戏化页面（schedule、特殊动画组件）允许保留特定设计色（emerald、rose、amber）"
    }
