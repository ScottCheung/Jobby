{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@jobby/ui": ["../../packages/ui/src/index.ts"],
      "@jobby/ui/*": ["../../packages/ui/src/*"],
      "next": ["./node_modules/next"],
      "next/*": ["./node_modules/next/*"],
      "@tanstack/react-query": ["./node_modules/@tanstack/react-query"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "pages/**/*.ts",
    "lib/**/*.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "components/forms.tsx",
    "lib/runtime.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
