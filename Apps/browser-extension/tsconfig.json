{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["chrome"],
    "baseUrl": ".",
    "paths": {
      "@jobby/ui": ["../../packages/ui/src/index.ts"],
      "@jobby/ui/*": ["../../packages/ui/src/*"],
      "@/*": ["./src/*", "../../packages/ui/src/*"]
    }
  },
  "include": ["src", "manifest.config.ts", "vite.config.ts"]
}
