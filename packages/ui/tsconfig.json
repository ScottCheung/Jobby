{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/lib/*": ["../../Apps/user/lib/*"],
      "@/components/*": ["../../Apps/user/components/*", "./src/components/*"],
      "@/styles/*": ["./src/styles/*"],
      "@jobby/ui": ["./src/index.ts"],
      "@jobby/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/*.stories.tsx"]
}
